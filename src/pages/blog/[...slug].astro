---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — Char's Arcade`} description={post.data.description}>
  <main class="page">
    <article class="page-window article-window">
      <div class="titlebar">
        <span class="light r"></span><span class="light y"></span><span class="light g"></span>
        <span class="title">{post.id}.md — zsh</span>
      </div>
      <div class="content article-content">
        <div class="article-meta">
          <span>{post.data.pubDate.toISOString().slice(0,10)}</span>
          <span>·</span>
          <span>{post.data.tags.join(' · ')}</span>
        </div>
        <h1>{post.data.title}</h1>
        <Content />
      </div>
    </article>
    <div class="article-nav">
      <a href="/blog">← All notes</a>
      <a href="/">Desktop ↗</a>
    </div>
  </main>
</BaseLayout>
